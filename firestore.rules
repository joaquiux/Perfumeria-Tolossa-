rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // TEMPORAL para migración inicial sin Auth configurado.
    // Después de crear el usuario admin, volver a exigir request.auth != null.
    match /products/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /meta/{doc} {
      allow read: if true;
      allow write: if true;
    }
  }
}
